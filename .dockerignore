# Docker build ignore — prevent secrets, logs, and runtime artifacts from entering the image
# ASSESSMENT_D01 P1-7: 增补 .env* / .git_disabled/ / coverage / test-output / logs

__pycache__
*.pyc
*.pyo
*.pyd
venv/
.venv/

# Git & CI
.git
.github
.git_disabled/

# Environment & secrets (CRITICAL — never bake into image)
.env
.env.*
!.env.example

# Documentation
*.md
docs/

# Tests & coverage artifacts
tests/
.pytest_cache/
.coverage
coverage.xml
coverage.json
test-output.txt
e2e-output.txt
test-results.xml
htmlcov/

# Runtime data
data/*
!.gitkeep
logs/
output/
deliverables/

# Build artifacts
dist/
build/
*.egg-info/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.log
.dbg/
