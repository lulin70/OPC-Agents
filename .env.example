# 环境变量模板 - 复制为 .env 并填写实际值

# ============== 应用基础 ==============
DEBUG=False
SECRET_KEY=change-me-in-production-use-random-secret-key-here

# ============== 数据库 ==============
# 开发环境使用 SQLite（默认）
DATABASE_URL=sqlite:///./opc_agents_v3.db
# 生产环境使用 PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/opc_agents

# ============== LLM 服务 ==============
# 可选值: mock / openai / ollama
LLM_PROVIDER=mock

# OpenAI 配置（当 LLM_PROVIDER=openai 时生效）
LLM_API_KEY=sk-your-openai-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Ollama 本地模型配置（当 LLM_PROVIDER=ollama 时生效）
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3

# LLM 通用参数
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=10.0
LLM_COST_BUDGET_DAILY=5.0

# ============== 认证与安全 ==============
ACCESS_TOKEN_EXPIRE_MINUTES=10080
RATE_LIMIT_PER_MINUTE=100

# ============== CORS ==============
CORS_ORIGINS=["http://localhost:8501","http://localhost:8000"]
