# 环境变量模板 - 复制为 .env 并填写实际值
# OPC-Agents v0.1.9-delta

# ============== LLM 服务 ==============
# 推荐配置 MOKA API（Claude Sonnet 4），质量最高
# 获取地址：https://moka-ai.com
MOKA_API_KEY=
MOKA_API_BASE=https://api.moka-ai.com/v1
MOKA_MODEL=moka/claude-sonnet-4-6

# 备选: 智谱GLM-4
# GLM_API_KEY=

# 备选: OpenAI
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1

# 备选: Ollama本地模型（无需API Key，使用OpenAI兼容端点）
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# LLM 通用参数
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60.0

# ============== 监控（可选）=============
# SENTRY_DSN=  # Sentry错误追踪，留空则不启用

# ============== MCP 服务 ==============
# MCP SSE端点认证密钥（强烈建议设置，否则MCP端点无认证保护）
# MCP_API_KEY=your-secure-random-key-here

# ============== 技能市场 ==============
# 技能市场API CORS允许的源（逗号分隔）
# MARKETPLACE_CORS_ORIGINS=http://localhost:8501,http://localhost:8900

# ============== 日志 ==============
LOG_DIR=logs
