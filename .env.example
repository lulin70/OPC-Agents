# 环境变量模板 - 复制为 .env 并填写实际值
# OPC-Agents v0.2.2
#
# LLM配置说明：
# OPC-Agents不提供LLM服务，也不存储任何API Key。
# 请选择适合你的LLM服务商，自行获取API Key并填入下方。
# 支持的后端（按优先级自动选择）：
#   1. MOKA (Claude Sonnet 4) — https://moka-ai.com
#   2. 智谱GLM-4 — https://open.bigmodel.cn
#   3. OpenAI — https://platform.openai.com
#   4. Ollama本地模型 — https://ollama.ai (无需API Key)
#
# === 加密密钥说明（v0.2.0 重要）===
# 首次启动时系统会自动在 .env.local 中生成加密密钥（Fernet对称密钥）
# .env.local 已加入 .gitignore 保护，不会被提交到版本库
# 如需手动设置，取消下方注释并填入你的密钥

# ============== 加密配置 ==============
# OPC_ENCRYPTION_KEY=your-fernet-key-here  # 首次启动自动生成，无需手动设置
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ============== LLM 服务 ==============
# 取消注释并填入你的API Key（只需配置一个即可）

# MOKA (Claude Sonnet 4)
# MOKA_API_KEY=your-moka-api-key-here
# MOKA_API_BASE=https://api.moka-ai.com/v1
# MOKA_MODEL=moka/claude-sonnet-4-6

# 智谱GLM-4
# GLM_API_KEY=your-glm-api-key-here

# OpenAI
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_API_BASE=https://api.openai.com/v1

# Ollama本地模型（无需API Key）
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# LLM 通用参数
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60.0

# ============== SMTP 邮件通知（可选）=============
# 配置后邮件通知将通过SMTP真实发送，否则仅记录到文件
# OPC_SMTP_HOST=smtp.gmail.com
# OPC_SMTP_PORT=587
# OPC_SMTP_USER=your-email@gmail.com
# OPC_SMTP_PASS=your-app-password
# OPC_SMTP_FROM=your-email@gmail.com
# OPC_SMTP_TLS=true

# ============== 执行引擎 ==============
# OPC_USE_AGENT_LOOP=false        # 使用三贤者执行循环（Plan→Act→Observe→Reflect）
# OPC_SKIP_REFLECT=false          # 跳过反思阶段（快速模式）
# OPC_DATA_DIR=data               # 数据存储目录

# ============== 工作目录 ==============
# OPC_WORKSPACE=.  # 默认为当前目录

# ============== 监控（可选）=============
# SENTRY_DSN=  # Sentry错误追踪，留空则不启用

# ============== MCP 服务 ==============
# MCP SSE端点认证密钥（强烈建议设置，否则MCP端点无认证保护）
# MCP_API_KEY=your-secure-random-key-here

# ============== 技能市场 ==============
# 技能市场API CORS允许的源（逗号分隔）
# MARKETPLACE_CORS_ORIGINS=http://localhost:8501,http://localhost:8900

# ============== 日志 ==============
LOG_DIR=logs

# ============== 国际化 (i18n) v0.2.0 ==============
# 界面语言（支持: zh_CN, en_US, ja_JP）
# OPC_LOCALE=zh_CN

# ============== 仪表盘配置 v0.2.0 ==============
# 默认布局: compact / standard / expanded
# OPC_DASHBOARD_LAYOUT=standard

# 默认密度: comfortable / compact / minimal
# OPC_DASHBOARD_DENSITY=comfortable

# ============== 引导模式 v0.2.0 ==============
# 是否跳过首次引导（开发者调试用）
# OPC_SKIP_ONBOARDING=false

# ============== 微信集成 v0.2.0 ==============
# WeChat AppID 和 AppSecret（可选，启用微信E2E功能时需要）
# WECHAT_APP_ID=your-wechat-app-id
# WECHAT_APP_SECRET=your-wechat-app-secret

# ============== 持久记忆 v0.2.2 ==============
# 启用 CarryMem 跨会话记忆（需安装: pip install opc-agents[memory]）
# CARRYMEM_ENABLED=false
# CARRYMEM_DB_PATH=~/.opc-agents/memory.db
# CARRYMEM_MAX_MEMORIES=10
# CARRYMEM_MAX_TOKENS=2000
# CARRYMEM_VECTOR_SEARCH=false

# ============== 外接知识库 ==============
# 启用知识库集成（支持: obsidian/local/yuque/feishu/notion/siyuan）
# OPC_KB_ENABLED=false
# OPC_KB_TYPE=local
# OPC_KB_PATH=~/knowledge
# OPC_KB_MAX_RESULTS=5
# OPC_KB_MAX_TOKENS=1500
# --- 语雀 ---
# YUQUE_TOKEN=your-yuque-token
# YUQUE_REPO=username/repo
# --- 飞书 ---
# FEISHU_APP_ID=your-app-id
# FEISHU_APP_SECRET=your-app-secret
# FEISHU_FOLDER_TOKEN=your-folder-token
# --- Notion ---
# NOTION_TOKEN=your-notion-token
# NOTION_DATABASE_ID=your-database-id
# --- 思源笔记 ---
# SIYUAN_API_URL=http://127.0.0.1:6806
# SIYUAN_TOKEN=your-siyuan-token
# SIYUAN_BOX=your-box-id
