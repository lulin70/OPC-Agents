# 环境变量模板 - 复制为 .env 并填写实际值
# OPC-Agents v0.1.0

# ============== 应用基础 ==============
DEBUG=False
SECRET_KEY=  # 留空则启动时自动生成

# ============== LLM 服务 ==============
# 推荐配置 MOKA API（Claude Sonnet 4），质量最高
MOKA_API_KEY=  # 填写你的MOKA API Key
MOKA_API_BASE=https://api.moka-ai.com/v1
MOKA_MODEL=moka/claude-sonnet-4-6

# 备选: 智谱GLM-4
# GLM_API_KEY=  # 填写你的智谱API Key

# 备选: OpenAI
# OPENAI_API_KEY=  # 填写你的OpenAI API Key
# OPENAI_API_BASE=https://api.openai.com/v1

# 备选: Ollama本地模型
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# LLM 通用参数
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60.0
LLM_COST_BUDGET_DAILY=5.0

# ============== 认证与安全 ==============
ACCESS_TOKEN_EXPIRE_MINUTES=10080
RATE_LIMIT_PER_MINUTE=100

# ============== CORS ==============
CORS_ORIGINS=["http://localhost:8501","http://localhost:8000"]
